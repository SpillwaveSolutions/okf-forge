# Build output and generated artifacts. Several of these are tracked, so
# without this list `prettier --check .` reports ~567 files and the format
# gate is meaningless.
dist/
.vercel/
.output/
.nitro/
node_modules/
src-tauri/target/
src-tauri/gen/
test-results/
playwright-report/

# Generated by TanStack Router.
src/routeTree.gen.ts

# Lockfiles are tool-owned.
package-lock.json
src-tauri/Cargo.lock

# worklog-owned state: the ledger, the config and the wiki cache. Written and
# read by bin/, not by hand.
.work/

# Fixtures the app fetches at runtime (the prebaked bundle, the plugin meta).
# Reformatting is semantically harmless but pure churn on generated data.
public/

# Vendored from the worklog plugin — re-copied on every upgrade, so any
# reformat here is lost and shows up as churn.
bin/

# Rendered by `worklog ia-render`; regenerating must stay byte-stable for the
# pre-commit freshness gate.
docs/.index/
docs/roadmap.md

# Markdown is excluded on purpose, not by oversight.
#
# public/sample-okf/**.md is the OKF fixture the app and the e2e suite load,
# and src/lib/okf/{frontmatter,markdown}.ts are hand-rolled, deliberately
# partial parsers — letting a formatter reflow frontmatter, link syntax or
# tables risks changing what the app actually parses, to gain nothing.
# Everything else in .md is prose, where reformatting is pure churn.
*.md

