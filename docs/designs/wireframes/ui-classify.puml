@startsalt
'
' Wireframe — Classify view. Authoritative for THREE things only:
'   1. element inventory (which named controls exist)
'   2. containment and reading order (header / sidebar | main / status)
'   3. ordinal sequence (nav order)
'
' NOT authoritative for pixels, spacing, colour, typography, icons, density or
' state styling. Salt draws monochrome boxes; the real UI is a dense workbench
' with two themes. Never diff a screenshot against this render.
'
' Render: npm run wireframes
'
{
  {* <&git-branch> OKFForge | "  Search concepts, types, tags...  " | [Preview] | [Markdown] | [Split] | [theme] | [Learn] | [Open] | [Classify] | [Save] }
  {
    {
      <b>NAV
      [Learn OKF]
      [Explorer]
      [Editor]
      [Graph & Search]
      [<b>Classify]
      [DeepAgents]
      [Plugins & MCP]
      --
      <b>SAMPLE-OKF | valid
      "  Filter files...  "
      --
      {T
      + agents
      ++ graph-engineer.md
      ++ index.md
      + knowledge
      ++ index.md
      }
    } |
    {
        <b>Classify into OKF
        "Drop raw markdown, get typed OKF paths."
        {
          [Upload files] | [Paste]
        }
        ==
        {
          "  # Incident runbook                    "
          "                                        "
          [Add] | [Classify]
        }
        ==
        {
          [X] include | ^Playbook^ | "  playbooks/incident-runbook.md  "
          "source excerpt ..."
        }
        {
          [X] include | ^Reference^ | "  knowledge/api-errors.md  "
          "source excerpt ..."
        }
        [Apply and build bundle]
      }
  }
  {- 22 concepts - 83 edges - healthy | agents/graph-engineer.md }
}
@endsalt
